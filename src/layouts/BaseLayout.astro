---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE, AREA } from '../consts';
import { withBase } from '../lib/paths';

export interface Props {
  title?: string;
  description?: string;
  path?: string; // ruta absoluta empezando por /
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  path = '/',
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — Ingeniería en Valencia, Alicante y Castellón`;
const canonical = `${SITE.url}${path}`;

// Schema base de la organización (LocalBusiness cuando haya dirección/teléfono).
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  areaServed: AREA.provinces.map((p) => ({ '@type': 'AdministrativeArea', name: p })),
  knowsAbout: [
    'Licencias de actividad',
    'Licencia ambiental',
    'Proyectos de naves agrícolas y ganaderas',
    'Industria agroalimentaria',
  ],
};

const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/logo-licenza.jpg`} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/logo-licenza.jpg`} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
