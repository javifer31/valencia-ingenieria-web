---
import type { Service } from '../data/services';
import { withBase } from '../lib/paths';
export interface Props { service: Service }
const { service } = Astro.props;
---
<div class="card group flex flex-col overflow-hidden transition-all hover:-translate-y-1 hover:border-brand-300 hover:shadow-lift">
  <a href={withBase(`/servicios/${service.slug}/`)} class="contents">
    <div class="-mx-6 -mt-6 mb-4 h-36 overflow-hidden">
      <img
        src={withBase(service.image)}
        alt={service.title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>
    <h3 class="text-lg font-semibold text-ink group-hover:text-brand-700">{service.title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-mute">{service.short}</p>
  </a>
  <div class="mt-4 flex items-center justify-between">
    <a href={withBase('/contacto/')} class="btn-primary text-xs">Conocer precios</a>
    <a href={withBase(`/servicios/${service.slug}/`)} class="text-sm font-medium text-brand-600 group-hover:translate-x-0.5">Ver más →</a>
  </div>
</div>
