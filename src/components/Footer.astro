---
import { SITE, AREA, CONTACT, hasContact } from '../consts';
import { services } from '../data/services';
const year = new Date().getFullYear();
const topServices = services.slice(0, 6);
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="container grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2.5 font-display text-lg font-bold text-brand-800">
        <img src="/logo-valencia-ingenieria.jpg" alt="Valencia Ingeniería - Logo" class="h-8 w-8 rounded-lg object-cover" />
        <span>{SITE.name}</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-mute">{SITE.description}</p>
      <p class="mt-4 text-sm font-medium text-brand-700">
        Servicio en toda la {AREA.region}: {AREA.provinces.join(' · ')}
      </p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-ink">Servicios</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {topServices.map((s) => (
          <li>
            <a href={`/servicios/${s.slug}/`} class="text-mute hover:text-brand-700">{s.title}</a>
          </li>
        ))}
        <li><a href="/servicios/" class="font-medium text-brand-700 hover:underline">Ver todos →</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-ink">Contacto</h3>
      <ul class="mt-4 space-y-2 text-sm text-mute">
        {hasContact ? (
          <>
            {CONTACT.email && <li><a href={`mailto:${CONTACT.email}`} class="hover:text-brand-700">{CONTACT.email}</a></li>}
            {CONTACT.phone && <li><a href={`tel:${CONTACT.phone}`} class="hover:text-brand-700">{CONTACT.phoneDisplay || CONTACT.phone}</a></li>}
            {CONTACT.address && <li>{CONTACT.address}</li>}
          </>
        ) : (
          <li><a href="/contacto/" class="hover:text-brand-700">Formulario de contacto</a></li>
        )}
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container flex flex-col items-center justify-between gap-2 py-5 text-xs text-mute md:flex-row">
      <p>© {year} {SITE.legalName}. Todos los derechos reservados.</p>
      <p>Honorarios orientativos, sin tasas ni IVA. Presupuesto cerrado sin compromiso.</p>
    </div>
  </div>
</footer>
