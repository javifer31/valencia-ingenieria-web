---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE, AREA } from '../../consts';
import { CATEGORIES, getServicesByCategory } from '../../data/services';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE.url}/servicios/` },
  ],
};
---

<BaseLayout
  title="Servicios de ingeniería en la Comunidad Valenciana"
  description="Licencias de actividad y ambientales, proyectos de naves agrícolas y ganaderas, e industria agroalimentaria en toda la Comunidad Valenciana. Honorarios orientativos y presupuesto sin compromiso."
  path="/servicios/"
  jsonLd={breadcrumb}
>
  <section class="border-b border-line bg-surface">
    <div class="container py-16">
      <p class="kicker">Servicios</p>
      <h1 class="mt-2 text-4xl font-bold">Servicios de ingeniería en la {AREA.region}</h1>
      <p class="mt-4 max-w-2xl text-lg text-mute">
        Todo lo que necesitas para abrir, construir o legalizar tu actividad.
        <a href="/contacto/" class="text-brand-600 font-semibold hover:text-brand-800">Consulta sin compromiso.</a>
      </p>
    </div>
  </section>

  {(Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[]).map((key) => (
    <section class="container py-16">
      <div class="mb-8 max-w-2xl">
        <h2 class="text-2xl font-bold text-brand-700">{CATEGORIES[key].label}</h2>
        <p class="mt-2 text-mute">{CATEGORIES[key].desc}</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {getServicesByCategory(key).map((s) => <ServiceCard service={s} />)}
      </div>
    </section>
  ))}
</BaseLayout>
