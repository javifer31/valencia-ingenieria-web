---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE, AREA } from '../../consts';
import { services, CATEGORIES } from '../../data/services';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const path = `/servicios/${service.slug}/`;
const related = services
  .filter((s) => s.category === service.category && s.slug !== service.slug)
  .slice(0, 3);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  description: service.short,
  provider: { '@type': 'ProfessionalService', name: SITE.name, url: SITE.url },
  areaServed: AREA.provinces.map((p) => ({ '@type': 'AdministrativeArea', name: p })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE.url}/servicios/` },
    { '@type': 'ListItem', position: 3, name: service.title, item: `${SITE.url}${path}` },
  ],
};
---

<BaseLayout
  title={service.metaTitle}
  description={service.short}
  path={path}
  jsonLd={[serviceSchema, faqSchema, breadcrumb]}
>
  <!-- Cabecera -->
  <section class="border-b border-line bg-gradient-to-b from-brand-50 to-white">
    <div class="container py-14">
      <nav class="text-sm text-mute">
        <a href={withBase('/')} class="hover:text-brand-700">Inicio</a>
        <span class="mx-1.5">/</span>
        <a href={withBase('/servicios/')} class="hover:text-brand-700">Servicios</a>
        <span class="mx-1.5">/</span>
        <span class="text-ink">{service.title}</span>
      </nav>
      <p class="kicker mt-6">{CATEGORIES[service.category].label}</p>
      <h1 class="mt-2 max-w-3xl text-4xl font-bold leading-tight">{service.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-mute">{service.intro}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a href={withBase('/contacto/')} class="btn-primary">Conocer precios</a>
        <a href={withBase('/contacto/')} class="btn-accent">Pedir presupuesto</a>
      </div>
    </div>
  </section>

  <div class="container grid gap-12 py-16 lg:grid-cols-3">
    <!-- Contenido -->
    <div class="lg:col-span-2">
      <div class="prose-block max-w-none">
        <h2 class="text-2xl font-bold">¿Para quién es?</h2>
        <p class="mt-3">{service.forWho}</p>

        <h2 class="mt-10 text-2xl font-bold">Qué incluye nuestro servicio</h2>
        <ul class="mt-4 space-y-3">
          {service.includes.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 grid h-5 w-5 flex-none place-items-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">✓</span>
              <span class="text-mute">{item}</span>
            </li>
          ))}
        </ul>

        <h2 class="mt-10 text-2xl font-bold">Preguntas frecuentes</h2>
        <div class="mt-4 divide-y divide-line rounded-2xl border border-line">
          {service.faq.map((f) => (
            <details class="group p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
                {f.q}
                <span class="text-brand-500 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-mute">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>

    <!-- Aside -->
    <aside class="space-y-6">
      <div class="card sticky top-24">
        <h3 class="text-lg font-semibold">¿Hablamos de tu proyecto?</h3>
        <p class="mt-2 text-sm text-mute">
          Te damos un presupuesto cerrado sin compromiso para toda la {AREA.region}.
        </p>
        <a href={withBase('/contacto/')} class="btn-primary mt-4 w-full">Pedir presupuesto</a>
        <p class="mt-4 text-xs text-mute">Honorarios técnicos, sin tasas ni IVA.</p>
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="container pb-8">
      <h2 class="mb-6 text-2xl font-bold">Servicios relacionados</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s) => <ServiceCard service={s} />)}
      </div>
    </section>
  )}
</BaseLayout>
