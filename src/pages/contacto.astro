---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, AREA, CONTACT, hasContact } from '../consts';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Contacto', item: `${SITE.url}/contacto/` },
  ],
};
---

<BaseLayout
  title="Contacto"
  description={`Pide presupuesto a ${SITE.name}. Consultoría de ingeniería para toda la Comunidad Valenciana.`}
  path="/contacto/"
  jsonLd={breadcrumb}
>
  <section class="border-b border-line bg-surface">
    <div class="container py-16">
      <p class="kicker">Contacto</p>
      <h1 class="mt-2 text-4xl font-bold">Pide presupuesto de ingeniería en Valencia, Alicante y Castellón</h1>
      <p class="mt-4 max-w-2xl text-lg text-mute">
        Cuéntanos qué quieres abrir, construir o legalizar. Te respondemos con un presupuesto
        cerrado para toda la {AREA.region}.
      </p>
    </div>
  </section>

  <section class="container grid gap-12 py-16 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <!-- Formulario. Cuando tengáis email, apuntar el action a Formspree/Make o backend propio. -->
      <form class="card space-y-5" method="POST" action="#" onsubmit="return false;">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-medium text-ink">Nombre</span>
            <input type="text" name="nombre" required class="mt-1.5 w-full rounded-xl border border-line px-4 py-2.5 outline-none focus:border-brand-400" />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-ink">Teléfono</span>
            <input type="tel" name="telefono" class="mt-1.5 w-full rounded-xl border border-line px-4 py-2.5 outline-none focus:border-brand-400" />
          </label>
        </div>
        <label class="block">
          <span class="text-sm font-medium text-ink">Email</span>
          <input type="email" name="email" required class="mt-1.5 w-full rounded-xl border border-line px-4 py-2.5 outline-none focus:border-brand-400" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink">Cuéntanos tu proyecto</span>
          <textarea name="mensaje" rows="5" required class="mt-1.5 w-full rounded-xl border border-line px-4 py-2.5 outline-none focus:border-brand-400"></textarea>
        </label>
        <button type="submit" class="btn-primary w-full">Enviar solicitud</button>
        <p class="text-xs text-mute">
          * Formulario de demostración. Se conectará al envío real cuando defináis el email/CRM de contacto.
        </p>
      </form>
    </div>

    <aside class="lg:col-span-2">
      <div class="card">
        <h2 class="text-lg font-semibold">Datos de contacto</h2>
        {hasContact ? (
          <ul class="mt-4 space-y-3 text-sm text-mute">
            {CONTACT.email && <li>✉️ <a href={`mailto:${CONTACT.email}`} class="hover:text-brand-700">{CONTACT.email}</a></li>}
            {CONTACT.phone && <li>📞 <a href={`tel:${CONTACT.phone}`} class="hover:text-brand-700">{CONTACT.phoneDisplay || CONTACT.phone}</a></li>}
            {CONTACT.address && <li>📍 {CONTACT.address}</li>}
          </ul>
        ) : (
          <p class="mt-3 text-sm text-mute">
            Estamos ultimando los datos de contacto directo. Mientras tanto, usa el formulario y te responderemos lo antes posible.
          </p>
        )}
        <div class="mt-6 border-t border-line pt-4">
          <p class="text-sm font-medium text-brand-700">Zona de servicio</p>
          <p class="mt-1 text-sm text-mute">Toda la {AREA.region}: {AREA.provinces.join(' · ')}.</p>
        </div>
      </div>
    </aside>
  </section>
</BaseLayout>
